<Project>
  <PropertyGroup>
    <_ProcessSentinelVersionFile>$(MSBuildThisFileDirectory)VERSION</_ProcessSentinelVersionFile>
    <_ProcessSentinelVersion Condition="Exists('$(_ProcessSentinelVersionFile)')">$([System.IO.File]::ReadAllText('$(_ProcessSentinelVersionFile)').Trim())</_ProcessSentinelVersion>
    <Version>$(_ProcessSentinelVersion)</Version>
  </PropertyGroup>
  <Target Name="ValidateProcessSentinelVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(_ProcessSentinelVersionFile)')" Text="Missing VERSION file at the repository root." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_ProcessSentinelVersion)', '^[0-9]+\.[0-9]+\.[0-9]+$'))" Text="VERSION must contain a version such as 0.1.4 (major.minor.patch)." />
  </Target>
</Project>
