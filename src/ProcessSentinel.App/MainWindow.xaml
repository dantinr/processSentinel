<Window x:Class="ProcessSentinel.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ProcessSentinel.Core;assembly=ProcessSentinel.Core"
        Title="行为哨兵 · ProcessSentinel" Width="1440" Height="960" MinWidth="1180" MinHeight="820" Background="#F4F7FB" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
    <Border Background="#132338" Padding="26,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#2864E9" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"><TextBlock Text="◎" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="行为哨兵" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="PROCESS SENTINEL   /   程序行为监控" Foreground="#94A9C1" FontSize="11" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#233A55" CornerRadius="14" Padding="12,6"><TextBlock x:Name="RunBadge" Text="●  等待选择目标" Foreground="#B9C9DA"/></Border><Button Content="使用说明" Margin="16,0,0,0" Background="#233A55" BorderBrush="#37506C" Foreground="White" Click="Help_Click"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="20,20,20,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><TextBlock Text="选择监控目标" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="RefreshButton" Content="刷新" HorizontalAlignment="Right" Padding="11,6" Click="Refresh_Click"/></Grid>
          <TextBox x:Name="ProcessSearch" Grid.Row="1" Margin="0,14,0,8" Style="{StaticResource SearchBox}" Tag="搜索进程名称、PID 或路径" ToolTip="按进程名、PID 或路径搜索" TextChanged="ProcessSearch_Changed"/>
          <TextBlock x:Name="ProcessCount" Grid.Row="2" Text="正在读取进程…" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
          <ListBox x:Name="ProcessList" Grid.Row="3" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" SelectionChanged="ProcessList_SelectionChanged">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id, StringFormat=PID {0}}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="4" Margin="0,14,0,0"><Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/><Button x:Name="LaunchButton" Content="＋  选择 .exe 并启动监控" Click="Launch_Click"/><TextBlock Text="开始时只提升采集器的权限。&#10;目标程序按普通权限运行。" Style="{StaticResource Caption}" LineHeight="19" Margin="0,10,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="166"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="19,16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="TargetTitle" Text="让程序的行为变得可见" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="TargetPath" Text="从左侧选择一个进程，或选择 .exe 启动并监控。" Foreground="#64748B" Margin="0,7,18,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><CheckBox x:Name="IncludeChildren" Content="同时跟踪已有和新建的子进程" IsChecked="True" Margin="0,13,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartButton" Content="开始监控" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" IsEnabled="False" Click="Start_Click"/><Button x:Name="StopButton" Content="停止" Margin="9,0,0,0" IsEnabled="False" Click="Stop_Click"/></StackPanel>
          </Grid>
        </Border>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,14">
          <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,10,0"><StackPanel><TextBlock Text="捕获事件" Style="{StaticResource Caption}"/><TextBlock x:Name="TotalText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ProcessStat" Text="0 个存活目标进程" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,10,0"><StackPanel><TextBlock Text="网络传输" Style="{StaticResource Caption}"/><TextBlock x:Name="TrafficText" Text="0 B" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="TrafficDetail" Text="↑ 0 B   ↓ 0 B" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,10,0"><StackPanel><TextBlock Text="文件 / 注册表事件" Style="{StaticResource Caption}"/><TextBlock x:Name="FileText" Text="0 / 0" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="记录操作和目标路径" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="16,13"><StackPanel><TextBlock Text="需要复核的事件" Style="{StaticResource Caption}"/><TextBlock x:Name="AlertText" Text="0" FontSize="25" Foreground="#B45309" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="行为线索 ≠ 恶意判定" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="KindFilter" Width="105" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="全部行为"/><ComboBoxItem Content="文件"/><ComboBoxItem Content="网络"/><ComboBoxItem Content="注册表"/><ComboBoxItem Content="进程"/><ComboBoxItem Content="模块"/></ComboBox>
              <CheckBox x:Name="RiskOnly" Grid.Column="1" Content="只看风险提示" Margin="14,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
              <TextBox x:Name="EventSearch" Grid.Column="2" MinWidth="100" Margin="0,0,12,0" Style="{StaticResource SearchBox}" Tag="搜索路径、IP、进程或原因" ToolTip="搜索路径、IP、进程名、操作或原因" TextChanged="EventSearch_Changed"/>
              <Button x:Name="ExportButton" Grid.Column="3" Content="导出日志" Padding="12,8" IsEnabled="False" Click="Export_Click"/>
            </Grid>
            <DataGrid x:Name="EventGrid" Grid.Row="1" SelectionChanged="EventGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="112"/>
                <DataGridTextColumn Header="进程 / PID" Binding="{Binding ProcessText}" Width="164" ElementStyle="{StaticResource GridText}"/>
                <DataGridTextColumn Header="类别" Binding="{Binding KindText}" Width="65"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="92"/>
                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*" MinWidth="120" ElementStyle="{StaticResource GridText}"/>
                <DataGridTemplateColumn Header="提示" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="4" Padding="5,4" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><DataTrigger Binding="{Binding Risk}" Value="{x:Static core:RiskLevel.Attention}"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger><DataTrigger Binding="{Binding Risk}" Value="{x:Static core:RiskLevel.High}"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding RiskText}" FontSize="11" Foreground="#475569"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="1" x:Name="EmptyState" IsHitTestVisible="False" Background="White" Margin="0,40,0,0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◎" FontSize="46" Foreground="#CBD5E1" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="等待第一条行为记录" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="文件访问、网络通信和子进程会显示在这里" Foreground="#94A3B8" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="15,9"><TextBlock x:Name="HistoryHint" Text="界面保留最近 5,000 条；全部收到的记录持续保存到本地日志。" Style="{StaticResource Caption}"/></Border>
          </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="17,13" Margin="0,14,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="DetailTitle" Text="事件证据" FontWeight="SemiBold" FontSize="14"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><TextBox x:Name="DetailText" Text="选择一条记录，查看完整目标、命令行和风险触发原因。&#10;风险提示需要结合程序用途判断，不能作为恶意软件结论。" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#64748B" Padding="0"/></ScrollViewer></Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="就绪 · 开始监控时会请求管理员权限" VerticalAlignment="Center" Foreground="#64748B" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="打开日志目录 ↗" Padding="4,4" BorderBrush="Transparent" Foreground="#2563EB" Click="OpenLogs_Click"/></Grid></Border>
  </Grid>
</Window>
